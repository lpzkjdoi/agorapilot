# ---------------------------------------------------------------------------
# Contrat de variables d'environnement de la production AgoraPilot.
#
# Ce fichier est versionné et ne contient JAMAIS de valeur sensible. Sur le VPS,
# le `.env` placé à côté de docker-compose.prod.yaml est régénéré à chaque
# déploiement par .github/workflows/deploy-prod.yml, depuis l'environnement
# GitHub `production` (Variables pour le non-sensible, Secrets pour le reste).
# Voir docs/deploiement-prod.md.
# ---------------------------------------------------------------------------

# --- Exposition ------------------------------------------------------------
# Domaine principal, sans schéma ni `www`. Enregistrements DNS A attendus vers
# l'IP du VPS pour `PROD_HOST` et `www.PROD_HOST` (redirigé vers le premier).
PROD_HOST=agorapilot.fr

# --- Images ----------------------------------------------------------------
# Obligatoire, sans repli : `prod-<version>`, posé par la CI depuis le tag
# `vX.Y.Z`. Pour revenir à une version précédente, redéployer son tag.
IMAGE_TAG=prod-1.0.0
BACK_IMAGE=ghcr.io/lpzkjdoi/agorapilot-back
FRONT_IMAGE=ghcr.io/lpzkjdoi/agorapilot-front

# --- Base de données -------------------------------------------------------
POSTGRES_DB=agorapilot
POSTGRES_USER=agorapilot
# Requis. Générer une valeur longue et aléatoire (openssl rand -hex 32). Il est
# figé à l'initialisation du volume : ne plus le changer ensuite.
POSTGRES_PASSWORD=

# --- Facebook Graph API (app Meta de PRODUCTION, distincte de la préprod) ---
FACEBOOK_API_VERSION=v25.0
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_PAGE_ID=

# --- Comptes ---------------------------------------------------------------
# Premier compte administrateur, créé seulement si la base est vide. Mot de
# passe provisoire (12 caractères au moins), à changer à la première connexion.
AGORAPILOT_ADMIN_USERNAME=
AGORAPILOT_ADMIN_PASSWORD=

# --- Diffusion planifiée (facultatif) ---------------------------------------
# PUBLICATION_WINDOW_START=15:00
# PUBLICATION_WINDOW_END=22:00

# --- Notifications (facultatif) ----------------------------------------------
NOTIFICATIONS_DISCORD_PROGRAMME_URL=
NOTIFICATIONS_DISCORD_ALERTES_URL=
NOTIFICATIONS_DISCORD_ESSAIS_URL=

# --- Divers ----------------------------------------------------------------
TZ=Europe/Paris
