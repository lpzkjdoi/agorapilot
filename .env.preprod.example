# ---------------------------------------------------------------------------
# Contrat de variables d'environnement de la préproduction AgoraPilot.
#
# Ce fichier est versionné et ne contient JAMAIS de valeur sensible : il sert de
# référence. Sur le VPS, le copier à côté de docker-compose.preprod.yaml sous le
# nom `.env`, le renseigner, puis le protéger :
#
#     cp .env.preprod.example .env && chmod 600 .env
#
# Docker Compose lit automatiquement ce `.env` pour l'interpolation ${...}.
# Toute variable sans valeur par défaut est obligatoire : `docker compose up`
# échoue explicitement si elle manque.
#
# À terme, ce même fichier sera régénéré sur le VPS par la CI GitHub depuis
# l'environnement `preprod` (Variables pour le non-sensible, Secrets pour le
# reste). Le format ne changera pas.
# ---------------------------------------------------------------------------

# --- Exposition ------------------------------------------------------------
# Nom d'hôte de la préproduction, sans schéma. Doit correspondre à un
# enregistrement DNS A pointant vers l'IP du VPS : c'est lui que Traefik utilise
# comme règle de routage et pour obtenir le certificat Let's Encrypt.
PREPROD_HOST=preprod.exemple.fr

# Accès public depuis le 2026-11-18 : plus de filtre IP (l'ancienne variable
# PREPROD_ALLOWED_CIDRS n'est plus lue).

# --- Images ----------------------------------------------------------------
# Tag déployé : `preprod-<sha>`, posé par la CI ; `preprod-latest` convient
# pour un déploiement manuel.
IMAGE_TAG=preprod-latest
BACK_IMAGE=ghcr.io/lpzkjdoi/agorapilot-back
FRONT_IMAGE=ghcr.io/lpzkjdoi/agorapilot-front

# --- Base de données -------------------------------------------------------
POSTGRES_DB=agorapilot
POSTGRES_USER=agorapilot
# Requis, sans valeur par défaut. Générer une valeur longue et aléatoire, par
# exemple : openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Facebook Graph API ----------------------------------------------------
FACEBOOK_API_VERSION=v25.0
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_PAGE_ID=

# Note : aucun token de page ici. Il n'est pas fourni par l'environnement mais
# obtenu depuis la page « Canal Facebook » (connexion OAuth, table
# facebook_connections). Cf. docs/configuration-meta.md.

# --- Comptes ---------------------------------------------------------------
# Premier compte, administrateur, créé au démarrage du back si la base n'a
# aucun compte. Le mot de passe est provisoire (12 caractères au moins) : il
# faut le changer à la première connexion. Facultatifs, et sans effet une fois
# un compte créé. Sans eux, une base vide démarre sans compte, et personne ne
# peut se connecter.
AGORAPILOT_ADMIN_USERNAME=
AGORAPILOT_ADMIN_PASSWORD=

# --- Diffusion planifiée ---------------------------------------------------
# Fenêtre de publication Facebook (heures locales, cf. TZ). Les diffusions
# programmées pour un jour, sans heure, y sont réparties uniformément.
# Facultatif : 15:00 et 22:00 par défaut.
# PUBLICATION_WINDOW_START=15:00
# PUBLICATION_WINDOW_END=22:00

# --- Notifications -------------------------------------------------------
# Webhooks des salons Discord (Modifier le salon → Intégrations → Webhooks).
# Secrets : le jeton est dans l'URL. Facultatifs : une URL vide désactive le
# salon. Programme du jour à 7h, échecs de diffusion, envois de test.
NOTIFICATIONS_DISCORD_PROGRAMME_URL=
NOTIFICATIONS_DISCORD_ALERTES_URL=
NOTIFICATIONS_DISCORD_ESSAIS_URL=

# --- Divers ----------------------------------------------------------------
# Fuseau des conteneurs. Détermine l'heure réelle du renouvellement de token
# (cron "0 0 3 * * *").
TZ=Europe/Paris
