# ---------------------------------------------------------------------------
# Contrat de variables d'environnement de la préproduction AgoraPilot.
#
# Ce fichier est versionné et ne contient JAMAIS de valeur sensible : il sert de
# référence. Sur le VPS, le copier à côté de docker-compose.preprod.yaml sous le
# nom `.env`, le renseigner, puis le protéger :
#
#     cp .env.preprod.example .env && chmod 600 .env
#
# Docker Compose lit automatiquement ce `.env` pour l'interpolation ${...}.
# Toute variable sans valeur par défaut est obligatoire : `docker compose up`
# échoue explicitement si elle manque.
#
# À terme, ce même fichier sera régénéré sur le VPS par la CI GitHub depuis
# l'environnement `preprod` (Variables pour le non-sensible, Secrets pour le
# reste). Le format ne changera pas.
# ---------------------------------------------------------------------------

# --- Exposition ------------------------------------------------------------
# Nom d'hôte de la préproduction, sans schéma. Doit correspondre à un
# enregistrement DNS A pointant vers l'IP du VPS : c'est lui que Traefik utilise
# comme règle de routage et pour obtenir le certificat Let's Encrypt.
PREPROD_HOST=preprod.exemple.fr

# Plages IP autorisées à joindre la préproduction, séparées par des virgules.
# Par défaut le seul sous-réseau WireGuard : toute autre source reçoit 403.
# La valeur par défaut est volontairement restrictive — en cas d'oubli, l'accès
# est fermé, pas ouvert. Élargir sciemment si besoin (ex. ajouter une IPv6 si un
# enregistrement AAAA est créé, sinon les clients IPv6 seraient rejetés).
PREPROD_ALLOWED_CIDRS=10.8.0.0/24

# --- Images ----------------------------------------------------------------
# Tag déployé. La CI y placera le SHA du commit ; `latest` convient pour un
# déploiement manuel.
IMAGE_TAG=latest
BACK_IMAGE=ghcr.io/lpzkjdoi/agorapilot-back
FRONT_IMAGE=ghcr.io/lpzkjdoi/agorapilot-front

# --- Base de données -------------------------------------------------------
POSTGRES_DB=agorapilot
POSTGRES_USER=agorapilot
# Requis, sans valeur par défaut. Générer une valeur longue et aléatoire, par
# exemple : openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Facebook Graph API ----------------------------------------------------
FACEBOOK_API_VERSION=v25.0
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_PAGE_ID=

# Note : aucun token de page ici. Il n'est pas fourni par l'environnement mais
# obtenu via POST /admin/facebook/bootstrap puis stocké en base (table
# facebook_tokens) et renouvelé par FacebookTokenScheduler.
# Cf. docs/deploiement-preprod.md.

# --- Divers ----------------------------------------------------------------
# Fuseau des conteneurs. Détermine l'heure réelle du renouvellement de token
# (cron "0 0 3 * * *").
TZ=Europe/Paris
